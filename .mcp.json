{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
          "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
          "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "shrimp-task-manager": {
      "command": "node",
      "args": ["C:/Users/LENOVO/Desktop/mcp-shrimp-task-manager/dist/index.js"],
      "env": {
          "DATA_DIR": "C:/Users/LENOVO/Desktop/supabase-app/shrimp_data",
          "TEMPLATES_USE": "en",
          "ENABLE_GUI": "false"
      }
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=fwjhsxkemumnttafcprk"
    }
  }
}